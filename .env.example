# Bagisto eğitimi — yerel ortam ayarları.
# kur.sh ilk çalıştığında bu dosyayı .env olarak kopyalar. Değişiklikleri .env'de yapın.
# Bu dosya Docker Compose ve kur.sh içindir; Bagisto'nun kendi ayarları bagisto/.env'dedir.

# Kurulacak Bagisto sürümü (GitHub etiketi: v<sürüm>).
BAGISTO_VERSION=2.5.1

# Mağazanın varsayılan dili, para birimi ve saat dilimi (yalnızca ilk kurulumda kullanılır).
# Örnek ürün verileri tüm desteklenen dillerde gelir; Türkçe için: BAGISTO_LOCALE=tr, BAGISTO_CURRENCY=TRY
BAGISTO_LOCALE=en
BAGISTO_CURRENCY=USD
BAGISTO_TIMEZONE=Europe/Istanbul

# İmaj ve servis sürümleri.
PHP_IMAGE=bagisto-egitimi/php
PHP_VERSION=8.4
NODE_VERSION=22
MYSQL_VERSION=8.4
ELASTICSEARCH_VERSION=8.19.21
ELASTICSEARCH_HEAP=512m

# Ana makinede açılan portlar. Çakışma olursa değiştirin.
# APP_PORT değişirse bagisto/.env içindeki APP_URL'yi de güncelleyin.
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_ES_PORT=9200
MAILPIT_PORT=8025
PHPMYADMIN_PORT=8081
KIBANA_PORT=5601
VITE_PORT=5173

# Xdebug: off (varsayılan), debug, develop, coverage ya da virgülle birleşimleri.
# Değiştirdikten sonra: docker compose up -d
XDEBUG_MODE=off

# Konteynerlerin dosya yazarken kullandığı kullanıcı. kur.sh bunları otomatik doldurur.
HOST_UID=
HOST_GID=
